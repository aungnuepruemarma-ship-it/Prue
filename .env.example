# NCP Environment Configuration

# Runtime
NCP_RUNTIME_WORKERS=8
NCP_EVENT_QUEUE_SIZE=100000
NCP_PLANNER_BEAM_WIDTH=32
NCP_MEMORY_WORKING_SIZE=1024

# Storage
NCP_STORAGE_BACKEND=sqlite
NCP_DATABASE_URL=sqlite:///data/ncp.db
NCP_VECTOR_STORE_URL=http://localhost:6333
NCP_REDIS_URL=redis://localhost:6379
NCP_S3_ENDPOINT=http://localhost:9000
NCP_S3_BUCKET=ncp-storage
NCP_S3_ACCESS_KEY=minioadmin
NCP_S3_SECRET_KEY=minioadmin

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
DEEPSEEK_API_KEY=...
VLLM_BASE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434

# Security
NCP_ENCRYPTION_KEY=
NCP_JWT_SECRET=
NCP_API_KEY=

# Monitoring
NCP_PROMETHEUS_PORT=9090
NCP_GRAFANA_PORT=3000
NCP_LOG_LEVEL=INFO

# Development
NCP_DEBUG=false
NCP_DEV_MODE=false
